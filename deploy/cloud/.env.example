# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
VECTRAUDIT_CLOUD_SECRET_KEY=
# The https:// address users and runners reach (used in links and for secure cookies).
VECTRAUDIT_CLOUD_PUBLIC_URL=https://vectraudit.example.com
# Optional: "Sign in with GitHub" (OAuth app callback: <PUBLIC_URL>/auth/github/callback).
VECTRAUDIT_CLOUD_GITHUB_CLIENT_ID=
VECTRAUDIT_CLOUD_GITHUB_CLIENT_SECRET=
# Optional: signed public report links (off by default).
VECTRAUDIT_CLOUD_SHARE_LINKS=false
