# A retrieval release check on every pull request (exported by the Vectraudit workbench).
#
# The target branch's release configuration is the approved one: its benchmark, k and
# policy judge both sides. The baseline runs the target branch's pipeline code and the
# candidate runs this pull request's, on the same runner, so latency is comparable.
# A pull request that proposes a new policy or benchmark is checked under the approved
# versions; the proposal is reported and applies after merge.
#
# Security: this runs on `pull_request`, never `pull_request_target`, so pull requests from
# forks get no secrets. Keep the pipeline credentials below read-only.

name: Retrieval release check

on:
  pull_request:

permissions:
  contents: read
  checks: write          # --github-check: the verdict as a check on the pull request
  pull-requests: write   # --github-comment: one summary comment, updated on each push

jobs:
  release-check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      VECTRAUDIT_VERSION: "__VERSION__"
      # Copy the wheel hash from the reviewed release handoff, then commit this pin.
      VECTRAUDIT_SHA256: "REPLACE_WITH_64_HEX_SHA256"
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

__INSTALL_PIPELINE__      - name: Retrieval release check
        # Installs the pinned release, runs the target branch's pipeline (baseline) and this
        # pull request's (candidate), checks them and keeps the report. Exit codes: 0 pass,
        # 1 error, 3 fail, 4 not comparable. Publishing is best effort: fork pull requests get
        # a read-only token and only the job summary.
        uses: ./.github/actions/retrieval-check
        with:
          repository: ${{ vars.VECTRAUDIT_DISTRIBUTION_REPOSITORY }}
          version: ${{ env.VECTRAUDIT_VERSION }}
          sha256: ${{ env.VECTRAUDIT_SHA256 }}
          token: ${{ secrets.VECTRAUDIT_DOWNLOAD_TOKEN }}
          mode: release
          release: __RELEASE__
          artifact-name: retrieval-release-check
__SIDE_ENV__
